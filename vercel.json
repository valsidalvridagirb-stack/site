{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/product.html",
      "destination": "/product",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/product",
      "destination": "/api/product"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    }
  ],
  "headers": [
    {
      "source": "/product",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "functions": {
    "api/scan-dimensions.js": {
      "maxDuration": 60
    },
    "api/scan-external-dimensions.js": {
      "maxDuration": 60
    },
    "api/cron-sync-ttn.js": {
      "maxDuration": 60
    },
    "api/cron-catalog-ideasport.js": {
      "maxDuration": 60
    },
    "api/cron-catalog-dropyesoriginal.js": {
      "maxDuration": 60
    },
    "api/cron-catalog-ultrasport.js": {
      "maxDuration": 60
    },
    "api/cron-catalog-tcross.js": {
      "maxDuration": 60
    },
    "api/cron-catalog-olxandery.js": {
      "maxDuration": 60
    },
    "api/cron-catalog-sync.js": {
      "maxDuration": 60
    },
    "api/catalog.js": {
      "maxDuration": 30
    },
    "api/product.js": {
      "includeFiles": "product-page.html"
    },
    "api/np-address.js": {
      "maxDuration": 15
    },
    "api/feed.js": {
      "maxDuration": 30
    },
    "api/sitemap.js": {
      "maxDuration": 30
    }
  }
}
