{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/product.html",
      "destination": "/product",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/product",
      "destination": "/api/product"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/cron/ttn",
      "destination": "/api/cron-sync-ttn"
    },
    {
      "source": "/cron/catalog-ideasport",
      "destination": "/api/catalog?action=ideasport"
    },
    {
      "source": "/cron/catalog-dropyesoriginal",
      "destination": "/api/catalog?action=dropyesoriginal"
    },
    {
      "source": "/cron/catalog-ultrasport",
      "destination": "/api/catalog?action=ultrasport"
    },
    {
      "source": "/cron/catalog-tcross",
      "destination": "/api/catalog?action=tcross"
    },
    {
      "source": "/cron/catalog-olxandery",
      "destination": "/api/catalog?action=olxandery"
    },
    {
      "source": "/cron/catalog-sync",
      "destination": "/api/catalog?action=sync"
    }
  ],
  "headers": [
    {
      "source": "/product",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "functions": {
    "api/scan-dimensions.js": {
      "maxDuration": 60
    },
    "api/cron-sync-ttn.js": {
      "maxDuration": 60
    },
    "api/catalog.js": {
      "maxDuration": 60
    },
    "api/product.js": {
      "includeFiles": "product-page.html"
    },
    "api/np-address.js": {
      "maxDuration": 15
    },
    "api/feed.js": {
      "maxDuration": 30
    },
    "api/sitemap.js": {
      "maxDuration": 30
    }
  }
}
