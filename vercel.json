{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/product.html",
      "destination": "/product",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/product",
      "destination": "/api/product"
    }
  ],
  "headers": [
    {
      "source": "/product",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "functions": {
    "api/scan-dimensions.js": {
      "maxDuration": 60
    },
    "api/scan-external-dimensions.js": {
      "maxDuration": 60
    },
    "api/cron-sync-ttn.js": {
      "maxDuration": 60
    },
    "api/product.js": {
      "includeFiles": "product-page.html"
    }
  }
}
